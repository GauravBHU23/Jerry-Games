# Copy to .env for local use, or set these in Vercel > Settings > Environment
# Variables. Never commit the real values - .env is gitignored.

# ---- winner email ----
# The Gmail address the congratulations mail is sent from.
MAIL_USER=gauravkum1275@gmail.com

# A Gmail APP PASSWORD, not the account password. Create one at:
#   Google Account > Security > 2-Step Verification > App passwords
# It looks like 16 letters, e.g. abcd efgh ijkl mnop (spaces are fine).
MAIL_PASS=

# Optional: an organiser address blind-copied on every winner mail, so you
# have a record of who won without opening the database.
MAIL_TO=

# ---- database ----
# Set automatically when you connect Postgres/Neon in Vercel > Storage.
# Leave blank locally: the game falls back to CSV files in ./media.
POSTGRES_URL=
